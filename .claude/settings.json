{
  "permissions": {
    "allow": [
      "Bash(mvn:*)",
      "Bash(./mvnw:*)",
      "Bash(sam validate:*)",
      "Bash(sam build:*)",
      "Bash(sam local:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(aws sts get-caller-identity:*)",
      "Bash(aws cloudformation describe-stacks:*)",
      "Bash(aws logs:*)"
    ],
    "ask": [
      "Bash(sam deploy:*)",
      "Bash(sam delete:*)",
      "Bash(sam sync:*)",
      "Bash(aws lambda invoke:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(aws iam create-access-key:*)",
      "Bash(aws * delete-*:*)",
      "Bash(rm -rf /:*)",
      "Read(./.env)",
      "Read(**/credentials)"
    ]
  }
}
